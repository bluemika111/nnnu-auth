#!/bin/sh /etc/rc.common
#===============================================================================
#  /etc/init.d/nnnu-auth — 常驻守护: 每 INTERVAL 秒检查一次, 掉线自动重认证
#  启用: /etc/init.d/nnnu-auth enable && /etc/init.d/nnnu-auth start
#        (或直接用 /usr/share/nnnu-auth/apply.sh, 它会按 uci 配置决定怎么跑)
#
#  注意: 常驻模式会一直持有互斥锁, 所以不要再同时配 cron 每分钟跑 ensure
#        (apply.sh 会自动二选一)
#===============================================================================
START=99
STOP=10
USE_PROCD=1

PROG=/usr/bin/nnnu-auth.sh
CONF=/etc/nnnu-auth.conf

start_service() {
    [ -x "$PROG" ] || { logger -t nnnu-auth "缺少 $PROG"; return 1; }

    # uci 里填了账号就重新渲染一次配置(手工改 conf 的老用法不受影响)
    _u=$(uci -q get nnnu-auth.main.username 2>/dev/null)
    [ -n "$_u" ] && [ -x /usr/share/nnnu-auth/render-conf.sh ] && \
        /usr/share/nnnu-auth/render-conf.sh

    if [ ! -r "$CONF" ]; then
        logger -t nnnu-auth "缺少 $CONF 且 uci 未配置, 不做认证"
        return 0
    fi

    rm -rf /tmp/nnnu-auth.lock

    procd_open_instance
    procd_set_param command "$PROG" monitor
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    rm -rf /tmp/nnnu-auth.lock
    logger -t nnnu-auth "已停止"
}

service_triggers() {
    procd_add_reload_trigger "nnnu-auth"
}
